# GitHub PAT used by the runner for `gh` (issues + PRs).
GITHUB_TOKEN=ghp_your_personal_access_token_here

# Cursor authentication for headless agent runs
# Generate a user API key at https://cursor.com/dashboard/integrations
# (under "API Keys"). It uses the same quota as your existing Cursor
# subscription — no extra billing. Required for autonomous tasks because
# the headless CLI cannot persist OAuth tokens reliably inside containers.
CURSOR_API_KEY=cursor_your_api_key_here

# Model used by `cursor-agent --print` inside each task container.
# `auto` lets Cursor pick the best model for each step (recommended).
# See `agent models` for the full list (composer-2, gpt-5.4, claude-4.6-opus, etc).
CURSOR_MODEL=auto

# Optional: only needed if you call OpenAI directly somewhere in the pipeline.
OPENAI_API_KEY=

# Worker runtime
MAX_PARALLEL_TASKS=3
VALIDATE_MODE=hybrid

# In-container service URLs (do not change unless compose services change).
DATABASE_URL=postgresql://sdl:sdl@db:5432/sdl_dev
REDIS_URL=redis://redis:6379

# Absolute host path of the parent repo's .git directory. The runner
# (scripts/run-task.sh) sets this automatically per worktree so that
# the worktree's `.git` pointer file resolves inside the container.
# Leave blank if running compose directly outside the agent runner.
HOST_REPO_GIT_DIR=
