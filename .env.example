OPENAI_API_KEY=sk-...
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sdl:sdl@localhost:5433/sdl
REDIS_PORT=6380
REDIS_URL=redis://localhost:6380
VITE_API_URL=http://localhost:3001

# Optional: weight of designScore in the blended overall validation score
# (0..1). discoveryScore weight is 1 - designWeight. Default 0.7.
# SCORING_DESIGN_WEIGHT=0.7

# Optional: per-purpose model overrides. Unset (or set to an empty / malformed
# value) falls back to the default shown. Generation quality is the
# highest-leverage spend here: the problem and the rubric are what every
# downstream behaviour — interviewer coaching, the discovery loop, validation,
# the debrief — is built on, so they run on the stronger tier by default, while
# the per-turn matchers stay cheap.
# AI_MODEL_PROBLEM=gpt-4o
# AI_MODEL_CRITERIA=gpt-4o
# AI_MODEL_VALIDATION=gpt-4o
# AI_MODEL_REFERENCE=gpt-4o
# AI_MODEL_DEBRIEF=gpt-4o
# AI_MODEL_INTERVIEWER=gpt-4o
# AI_MODEL_TUTOR=gpt-4o-mini
# AI_MODEL_DISCOVERY=gpt-4o-mini
# AI_MODEL_PROPOSALS=gpt-4o-mini
# AI_MODEL_BACKFILL=gpt-4o-mini

# --- Voice (spoken interviews over the OpenAI Realtime API) ---
# Speech-to-speech model and the streaming transcriber for candidate audio.
# AI_MODEL_VOICE=gpt-realtime-2.1
# AI_MODEL_VOICE_TRANSCRIPTION=gpt-live-transcribe
#
# Interviewer voice. One of: alloy, ash, ballad, cedar, coral, echo, marin,
# sage, shimmer, verse. An unrecognised value falls back to the default.
# AI_VOICE_NAME=marin
#
# Turn detection. `semantic_vad` scores how FINISHED the candidate's speech
# sounds and waits longer when it trails off, which is what lets someone pause
# for eight seconds mid-thought while drawing without being interrupted.
# `eagerness=low` stretches that wait further. Only change this if the
# interviewer feels too slow to respond — the failure in the other direction
# (being cut off mid-design) is far more damaging.
# VOICE_TURN_DETECTION=semantic_vad
# VOICE_VAD_EAGERNESS=low
#
# Escape hatch: a fixed silence threshold instead of the model. Note the
# default here is 2500ms, not the API's own 500ms, which cuts a candidate in
# half mid-sentence.
# VOICE_TURN_DETECTION=server_vad
# VOICE_SILENCE_MS=2500
#
# Ceilings. Unlike every other AI call here, a voice session bills for as long
# as its socket is open: roughly $0.02 per minute heard and $0.08 per minute
# spoken, so a 45-minute interview lands near $2. A forgotten tab keeps
# charging, hence both of these.
# VOICE_MAX_SESSION_MINUTES=60
# VOICE_IDLE_TIMEOUT_SECONDS=300
